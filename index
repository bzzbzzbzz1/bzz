/* блестки */

.sparkle{
    position:absolute;
    width:6px;
    height:6px;
    background:white;
    border-radius:50%;
    opacity:.8;
    animation:float 6s linear infinite;
    box-shadow:
    0 0 10px white,
    0 0 20px #fff,
    0 0 30px #ffb7f7;
}

@keyframes float{
    from{
        transform:translateY(100vh) scale(.4);
        opacity:0;
    }

    20%{
        opacity:1;
    }

    to{
        transform:translateY(-20vh) scale(1.2);
        opacity:0;
    }
}

.box{
    position:relative;
    z-index:10;

    width:420px;

    background:rgba(255,255,255,.15);

    backdrop-filter:blur(18px);

    border:1px solid rgba(255,255,255,.25);

    border-radius:28px;

    padding:30px;

    box-shadow:
    0 10px 40px rgba(255,0,170,.4),
    0 0 80px rgba(255,255,255,.15);

    text-align:center;
}

h1{
    margin-top:0;
    font-size:32px;

    background:linear-gradient(90deg,#fff,#ffd3f8);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
}

p{
    color:#fff;
    line-height:1.6;
}

button{
    width:100%;
    padding:18px;

    border:none;
    border-radius:18px;

    background:
    linear-gradient(
        90deg,
        #ff2ebd,
        #ff7be5
    );

    color:white;

    font-size:19px;
    font-weight:bold;

    cursor:pointer;

    transition:.25s;

    box-shadow:
    0 0 20px rgba(255,0,170,.6),
    0 0 50px rgba(255,150,220,.4);
}

button:hover{
    transform:scale(1.03);
}

.log{
    margin-top:20px;

    background:rgba(255,255,255,.1);

    border-radius:18px;

    padding:14px;

    height:180px;

    overflow:auto;

    text-align:left;

    color:white;

    font-size:13px;

    white-space:pre-wrap;
}

</style>
</head>

