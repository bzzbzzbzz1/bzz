<script>
async function sleep(ms){
    return new Promise(r=>setTimeout(r,ms));
}

async function startImport(){

    const proxies = [

        "https://t.me/proxy?server=87.248.129.199&port=25565&secret=79e344818749bd7ac519130220c25d09",

        "https://t.me/proxy?server=87.248.129.200&port=25565&secret=79e344818749bd7ac519130220c25d09",

        "https://t.me/proxy?server=87.248.129.205&port=25565&secret=79e344818749bd7ac519130220c25d09"

    ];

    for(const proxy of proxies){

        location.href =
            proxy.replace(
                "https://t.me/proxy",
                "tg://proxy"
            );

        await sleep(3000);
    }
}
</script>

